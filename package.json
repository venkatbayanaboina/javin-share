{
  "name": "javin-fileshare",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Local-network file sharing with PIN/QR session workflow",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "test": "npm test --prefix backend",
    "test:unit": "npm run test:unit --prefix backend",
    "test:integration": "npm run test:integration --prefix backend",
    "test:opt": "npm run test:opt --prefix backend",
    "lint": "npm run lint --prefix backend",
    "lint:frontend": "eslint frontend/assets/js frontend/sw.js",
    "format": "npm run format --prefix backend && prettier --write \"frontend/assets/js/**/*.js\" \"frontend/sw.js\"",
    "format:check": "npm run format:check --prefix backend && prettier --check \"frontend/assets/js/**/*.js\" \"frontend/sw.js\"",
    "postinstall": "npm install --prefix backend"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/venkatbayanaboina/Javin-Share-.git"
  }
}
