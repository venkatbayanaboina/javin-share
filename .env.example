# Server
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
# Auto-open a browser tab on server start (the launchers open their own tab)
OPEN_BROWSER=false

# Hostname advertised to joining devices via mDNS + TLS cert (optional).
# Leave empty to fall back to the OS hostname.
CUSTOM_HOST=javin.share.local

# Session
PIN_EXPIRY_MS=300000
GRACE_PERIOD_MS=30000
MAX_GRACE_MS=120000

# Transfer
MAX_FILE_SIZE_BYTES=53687091200
MAX_CONCURRENT_DOWNLOADS=3

# Security (PIN brute-force protection)
PIN_MAX_ATTEMPTS=8
PIN_RATE_WINDOW_MS=900000
PIN_LOCKOUT_MS=300000
UPLOADS_DIR=./backend/uploads

# TLS (generated locally by setup scripts)
CERTS_DIR=./backend/certs

# Transfer strategy: relay-disk (default) | relay-stream | relay-buffered
TRANSFER_DEFAULT_STRATEGY=relay-disk
# Stream relay is opt-in: single-receiver transfers skip the disk entirely
TRANSFER_ENABLE_STREAM_RELAY=false
# Per-receiver branch buffer before backpressure engages (bytes)
TRANSFER_CHUNK_SIZE_BYTES=1048576
# Buffered strategy spills to disk beyond this to cap per-file RAM (bytes)
TRANSFER_SPOOL_THRESHOLD_BYTES=33554432
TRANSFER_STREAM_RELAY_TIMEOUT_MS=30000
TRANSFER_MAX_RECEIVER_BUFFER_SIZE=16777216
TRANSFER_ENABLE_BUFFERED_BACKPRESSURE=false
